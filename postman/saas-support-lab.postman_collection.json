  "item": [
    {
      "name": "Get existing study",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Returns the requested study and a status\", function () {\n    const body = pm.response.json();\n    pm.expect(body.study_id).to.eql(\"LAB-001\");\n    pm.expect(body.status).to.be.a(\"string\").and.not.empty;\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/studies/LAB-001",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "studies",
            "LAB-001"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get missing study",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns HTTP 404\", function () {\n    pm.response.to.have.status(404);\n});\n\npm.test(\"Identifies the missing study\", function () {\n    const body = pm.response.json();\n    pm.expect(body.error).to.eql(\"Study not found\");\n    pm.expect(body.study_id).to.eql(\"LAB-999\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/studies/LAB-999",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "studies",
            "LAB-999"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ]
}
